# Configure a strong private token before first startup.
BOOTSTRAP_TOKEN=replace-with-at-least-32-random-characters
POLSIADB=./polsia.db
# Opt-in to outbound public HTTPS research. Requires configured egress.
POLSIA_NETWORK_ENABLED=0
# Independently opt into <=10 explicit sources/company, refreshed no faster than 24h.
POLSIA_CULTURE_REFRESH_ENABLED=0
# Optional, bounded source subscriptions: read only and no more than daily.
POLSIA_LEARNING_ENABLED=0

# Self-hosted SI runtime: no hosted AI services and NO API keys.
# Install a compatible local Ollama model separately (never auto-download).
POLSIA_AI_ENABLED=0
POLSIA_LOCAL_MODEL=
# Native host: http://127.0.0.1:11434 ; Docker uses http://ollama:11434.
POLSIA_LOCAL_AI_URL=http://127.0.0.1:11434
POLSIA_AI_DAILY_CALL_LIMIT=10

# v0.5 browser identity. In production set POLSIA_ENV=production,
# POLSIA_SECURE_COOKIES=1, and clear BOOTSTRAP_TOKEN entirely.
POLSIA_ENV=development
POLSIA_SECURE_COOKIES=0
# Only enable temporarily for initial company owner registration. Then disable.
POLSIA_SIGNUP_ENABLED=0
